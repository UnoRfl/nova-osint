# Copy to .env and fill in what you have. NOVA reads keys from the environment
# and from config.json; the environment always wins. .env is git-ignored and is
# never loaded unless you pass --env-file.
#
# Every module below works without its key; the key only raises limits or
# unlocks a source. `nova modules` shows which are currently active, and the
# desktop app's Settings window says the same thing per key.

# ---------------------------------------------------------------- free, useful

# Raises GitHub's API limit from 60/hour to 5000/hour. A classic token with NO
# scopes ticked is enough - this tool only reads public data.
# Used by: github, gists, email          https://github.com/settings/tokens
GITHUB_TOKEN=

# Blocklist verdicts from ~70 vendors, content categories, popularity rank and
# passive DNS for domains and IPs. Free tier is ~4 requests/min, 500/day, and
# is non-commercial use only.
# Used by: virustotal            https://www.virustotal.com/gui/my-apikey
VT_API_KEY=

# IP abuse confidence score and recent report categories.
# Used by: abuseipdb                 https://www.abuseipdb.com/account/api
ABUSEIPDB_API_KEY=

# ----------------------------------------------------------------------- paid

# Historical DNS and PRE-PRIVACY WHOIS - the registrant name and email a domain
# carried before redaction.
#
# NOT FREE. Checked 2026-09-17: the published plans are Professional $500/mo,
# Business $1500/mo and Enterprise, and the API page says the API is paid. The
# old small free tier is no longer documented. Signing up costs nothing and
# takes no card, so check the dashboard for any remaining allowance.
#
# Queries are metered per month, so the module spends 1 per scan by default;
# set "module_options": {"securitytrails_depth": "full"} in config.json for the
# subdomain list and WHOIS history (3 per scan).
# Used by: securitytrails            https://securitytrails.com/app/signup
SECURITYTRAILS_API_KEY=

# Enables the per-address breach lookup (`pwned`). Domain-level breach data
# (`breaches`) already works without it.
# Used by: pwned                      https://haveibeenpwned.com/API/Key
HIBP_API_KEY=

# ------------------------------------------------- declared but NOT USED YET
#
# No module reads the keys below. Setting them does nothing today; they are
# kept so the names stay stable if a module is written for them. The `ip`
# module already gets Shodan data from the keyless InternetDB endpoint.

SHODAN_API_KEY=
HUNTER_API_KEY=
NUMVERIFY_API_KEY=
EMAILREP_API_KEY=
