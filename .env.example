# Copy to .env and fill in what you have. NOVA reads keys from the environment
# only, and .env is git-ignored - it is never loaded unless you pass --env-file.
#
# Every module below works without its key; the key only raises limits or
# unlocks a source. `nova modules` shows which are currently active.

# Raises GitHub's API limit from 60/hour to 5000. A classic token with NO
# scopes ticked is enough - this tool only reads public data.
GITHUB_TOKEN=

# Paid. Enables per-address breach lookup (`pwned`). Domain-level breach data
# works without it.
HIBP_API_KEY=

# Free tier. IP abuse reputation.
ABUSEIPDB_API_KEY=

# Optional extras
SHODAN_API_KEY=
VT_API_KEY=
SECURITYTRAILS_API_KEY=
HUNTER_API_KEY=
NUMVERIFY_API_KEY=
EMAILREP_API_KEY=
