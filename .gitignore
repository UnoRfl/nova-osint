# secrets - also listed in .claudeignore, because one of the two alone leaves
# the other path open: git-ignored files are still readable by an agent, and
# agent-ignored files still commit.
.env
.env.*
!.env.example
*.key
*.pem
secrets.json
# config.json may hold API keys (core/config.py: api_keys block)
config.json
nova-config.json

# scan output: reports contain data about real people and infrastructure
reports/
out/
output/
*.osint.log
nova*.log
*.osint.json
*.osint.html

# pyinstaller output - the .exe is a release artifact, not source
build/
dist/
*.manifest

# python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# editors / os
.vscode/
.idea/
.DS_Store
Thumbs.db
